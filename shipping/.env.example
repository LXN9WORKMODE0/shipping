# Copy this file to .env and fill the values needed for local API tests.
# .env is ignored by git.

# MinerU PDF -> Markdown API
MINERU_API_URL=https://mineru.net
MINERU_API_KEY=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
MINERU_PAGE_RANGES=
MINERU_MAX_WAIT_SECONDS=1800
MINERU_POLL_INTERVAL_SECONDS=5

# OpenAI-compatible chat completion API for card analysis
LLM_ANALYSIS_API_URL=
LLM_ANALYSIS_API_KEY=
